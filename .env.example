# Mystical School: copy to .env and fill in. Never commit .env.

APP_URL=http://localhost:3000
DATABASE_PATH=./data/mystical-school.db
# Any long random string (node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
SESSION_SECRET=

# Text guide (OpenRouter: https://openrouter.ai)
OPENROUTER_API_KEY=
GUIDE_MODEL_FREE=anthropic/claude-haiku-5.5
GUIDE_MODEL_PAID=anthropic/claude-sonnet-5.5
GUIDE_MODEL_UTILITY=anthropic/claude-haiku-5.5

# Voice guide (Google Gemini Live). The server mints single-use tokens; the key never reaches the browser.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede

# Face-to-face video guide (Tavus CVI). Needs a Sophia persona: `npm run tavus:persona -- --yes`
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
MYSTICAL_TAVUS_PERSONA_ID=

# SmartMeet rooms for community gatherings. Creates real meetings on smartmeet.org when true.
SMARTMEET_ENABLED=false
SMARTMEET_API_URL=https://api.smartmeet.org/meeting-suite/v1/api/external
SMARTMEET_API_KEY=

# Payments: only the simulated local provider exists today.
PAYMENTS_PROVIDER=local-test

# Local test accounts created by `npm run setup`
SEED_ADMIN_EMAIL=admin@mystical-school.test
SEED_ADMIN_PASSWORD=
SEED_MEMBER_EMAIL=seeker@mystical-school.test
SEED_MEMBER_PASSWORD=
